# Copy to .env (never commit it). Credentials stay out of the repo and out of settings.yaml.

# Demo / local run: two SQLite files created by `pricing-reconciler seed`
RECON_ECC_URL=sqlite:///demo/ecc47.db
RECON_S4_URL=sqlite:///demo/s4hana.db

# SQL Server with SQL login:
# RECON_ECC_URL=mssql+pyodbc://recon_user:CHANGE_ME@sqlhost/ECC47?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# RECON_S4_URL=mssql+pyodbc://recon_user:CHANGE_ME@sqlhost/S4H?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# SQL Server with Windows authentication (typical for a scheduled task on a domain VM):
# RECON_ECC_URL=mssql+pyodbc://@sqlhost/ECC47?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# RECON_S4_URL=mssql+pyodbc://@sqlhost/S4H?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
